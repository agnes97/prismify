// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_PRISMA_URL") // uses connection pooling
  directUrl         = env("DATABASE_URL_NON_POOLING") // uses a direct connection
  shadowDatabaseUrl = env("DATABASE_SHADOW_URL")
}

// Shopping Mall
enum CompareMethod {
  EQUAL
  INCLUDES
}

model CategoryType {
  name       String        @id
  places     String[]      @default([])
  lowercase  Boolean       @default(false)
  compare    CompareMethod @default(INCLUDES)
  categories Category[]
}

model Category {
  name             String       @id
  emoji            String
  CategoryType     CategoryType @relation(fields: [categoryTypeName], references: [name])
  categoryTypeName String
  keys             String[]     @default([])
  items            Item[]
}

model Item {
  id           BigInt     @id
  title        String
  description  String
  countryCode  String
  priceNumeric Float
  currency     String
  url          String
  brand        String
  thumbnailSrc String
  lastActivity DateTime
  categories   Category[]
  isReserved   Boolean    @default(false)
  isSold       Boolean    @default(false)
}

// Auth
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  createdAt    DateTime  @default(now())
  lastLoggedIn DateTime?
  profile      Profile?
  AiKeys       AiKey[]
  AiCalls      AiCall[]
}

// AI services a reader can connect with their own API key
enum AiProvider {
  OPENAI
}

// a reader's own API key for one provider, sealed with AI_KEYS_SECRET, e.g. for the library's AI-drawn spines
model AiKey {
  User      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  provider  AiProvider
  cipher    String // iv.tag.sealed, each base64
  hint      String // the key's last four characters, to tell which one is connected
  createdAt DateTime   @default(now())

  @@id([userId, provider])
}

// one call made on a reader's key, counted so a stolen login can't run up their bill
model AiCall {
  id        String     @id @default(uuid())
  User      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  provider  AiProvider
  createdAt DateTime   @default(now())

  @@index([userId, provider, createdAt])
}

model Profile {
  id     String  @id
  user   User    @relation(fields: [id], references: [id])
  name   String
  avatar String?

  Rating     Rating[]
  RatingItem RatingItem[]
  RatingVote RatingVote[]

  LibraryRead  LibraryReading[] @relation("LibraryReadingsRead")
  LibraryAdded LibraryReading[] @relation("LibraryReadingsAdded")

  CinemaWatched    CinemaEntry[]     @relation("CinemaEntriesViewer")
  CinemaAdded      CinemaEntry[]     @relation("CinemaEntriesAdded")
  CinemaLinksSent  CinemaLink[]      @relation("CinemaLinksFrom")
  CinemaLinksGot   CinemaLink[]      @relation("CinemaLinksTo")
  CinemaPreference CinemaPreference?
}

// CV
model Access {
  id String @id
}

model AccessLog {
  id         String   @id @default(uuid())
  accessCode String
  createdAt  DateTime @default(now())
}

model CV {
  id   String @id
  data Json
}

// Rating
model Rating {
  id           String       @id
  title        String
  hasFavorites Boolean      @default(true)
  maxRating    Int          @default(5)
  minRating    Int          @default(0)
  countryCode  String       @default("cz")
  startDate    DateTime     @default(now())
  endDate      DateTime?
  emoji        String?
  Participants Profile[]
  RatingItem   RatingItem[]
}

model RatingItem {
  id           String       @id @default(uuid())
  rating       Rating       @relation(fields: [ratingId], references: [id])
  ratingId     String
  title        String
  data         Json
  FavoriteBy   Profile?     @relation(fields: [favoriteById], references: [id])
  favoriteById String?
  RatingVote   RatingVote[]
}

model RatingVote {
  id            String     @id @default(uuid())
  rating        Int
  RatingItem    RatingItem @relation(fields: [ratingItemId], references: [id])
  ratingItemId  String
  Participant   Profile    @relation(fields: [participantId], references: [id])
  participantId String

  @@unique([ratingItemId, participantId])
}

// Library
model LibraryBook {
  id           String           @id // Open Library work id, e.g. "OL45804W"
  title        String
  authors      String[]         @default([])
  year         Int?
  pages        Int?
  coverUrl     String? // mirrored into Vercel Blob, or Open Library's until it is
  coverColor   String? // the cover's dominant colour, e.g. "#4a2a1c", for the spine
  spineUrl     String? // a photo of the real spine in Vercel Blob, drawn on the shelf instead of cloth
  spineColor   String? // that photo's dominant colour, which dyes the cloth over the cover's
  spineRatio   Float? // that photo's width over its height, so it keeps its shape on the shelf
  isbn         String?
  description  String?
  series       String? // shared by the volumes of a series that lie flat in piles, e.g. "Frieren"
  seriesNumber Float? // its place in that series, e.g. 3, or 1.5 for a novella between
  createdAt    DateTime         @default(now())
  Readings     LibraryReading[]
}

model LibraryReading {
  id        String      @id @default(uuid())
  Book      LibraryBook @relation(fields: [bookId], references: [id])
  bookId    String
  readYear  Int
  readDate  DateTime?   @db.Date // null when only the year is remembered
  ReadBy    Profile     @relation("LibraryReadingsRead", fields: [readById], references: [id])
  readById  String
  AddedBy   Profile     @relation("LibraryReadingsAdded", fields: [addedById], references: [id])
  addedById String
  createdAt DateTime    @default(now())

  @@index([readById])
}

// Cinema
enum CinemaKind {
  MOVIE
  TV
}

enum CinemaState {
  UPCOMING
  WATCHING
  WATCHED
}

model CinemaTitle {
  id               String        @id // TMDB id with its kind, e.g. "movie:603" or "tv:1399"
  kind             CinemaKind
  title            String
  year             Int?
  genres           String[]      @default([]) // TMDB's genre names, in TMDB's order
  originalLanguage String?
  posterUrl        String?
  backdropUrl      String?
  overview         String?
  trailerKey       String? // the YouTube video of its trailer
  collection       String? // shared by the films of a franchise that lie flat in stacks, e.g. "The Matrix Collection"
  collectionOrder  Int? // its place in that franchise by release, from 1
  tvmazeId         Int? // where its episode schedule is read from
  imdbId           String?
  seasons          Int?
  episodeCounts    Int[]         @default([]) // episodes in each season from season 1, for +1 to roll over
  status           String? // TMDB's, e.g. "Returning Series", "Ended" or "Released"
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  Entries          CinemaEntry[]
}

// one person's copy of a title on their shelf
model CinemaEntry {
  id          String      @id @default(uuid())
  Title       CinemaTitle @relation(fields: [titleId], references: [id])
  titleId     String
  Viewer      Profile     @relation("CinemaEntriesViewer", fields: [viewerId], references: [id])
  viewerId    String
  AddedBy     Profile     @relation("CinemaEntriesAdded", fields: [addedById], references: [id])
  addedById   String
  state       CinemaState
  season      Int? // the last episode watched, for series
  episode     Int? // 0 before the season's first
  watchedYear Int?
  watchedDate DateTime?   @db.Date // null when only the year is remembered
  togetherId  String? // shared by the entries of people who watch it together
  mainGenre   String? // the genre picked to style it by over TMDB's first
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([viewerId, titleId])
  @@index([togetherId])
}

// two people who see each other's shelves, once the invited one accepts
model CinemaLink {
  id         String    @id @default(uuid())
  From       Profile   @relation("CinemaLinksFrom", fields: [fromId], references: [id])
  fromId     String
  To         Profile   @relation("CinemaLinksTo", fields: [toId], references: [id])
  toId       String
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([fromId, toId])
  @@index([toId])
}

// whose shelves the cinema opens on
model CinemaPreference {
  Profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String   @id
  view      String // "everyone", "me", "both", "together" or a linked person's id
  updatedAt DateTime @updatedAt
}
